<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qbo_home_assistant</name>
  <version>0.1.0</version>
  <description>
    ROS2 bridge between the Qbo robot and Home Assistant via WebSocket.
    Publishes entity state changes as topics and exposes HA service calls
    as ROS2 services.  No web interface — command/control through ROS2 only.
  </description>
  <maintainer email="contact@konexinc.fr">Konex Inc</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>qbo_ha_interfaces</exec_depend>
  <exec_depend>python3-websockets</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
